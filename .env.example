# Environment mode: development | production
ENVIRONMENT=development

# Monday.com API credentials
MONDAY_API_TOKEN=your_monday_api_personal_access_token_here
MONDAY_API_URL=https://api.monday.com/v2
MONDAY_WORK_ORDERS_BOARD_ID=your_work_orders_board_id_here
MONDAY_DEALS_BOARD_ID=your_deals_board_id_here

# Board cache TTL in seconds (default: 300)
BOARD_CACHE_TTL_SECONDS=300

# Groq API configuration (Official Python Groq SDK)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
